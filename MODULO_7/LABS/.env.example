# Copiar a .env y pegar tu API key de Google AI Studio
# (https://aistudio.google.com/apikey, es gratis).
GOOGLE_API_KEY=tu-api-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Opcional: modelo de Gemini (por defecto, gemini-2.5-flash).
# Google limita los modelos 2.5 a quienes ya los usaron. Si tu key es nueva y la primera
# llamada falla con "modelo no disponible", probá uno más nuevo (por ejemplo gemini-3.8-flash).
# DEMO_MODEL=gemini-2.5-flash

# Opcional: llamadas simultáneas al modelo (por defecto, 2). Bajalo a 1 si ves muchos
# reintentos por cuota; subilo si tu cuota lo permite.
# DEMO_CONCURRENCIA=2

# Opcional: tope del costo medido, en dólares a precio de lista (por defecto, 0.60).
# Si una corrida lo supera, se corta.
# DEMO_TOPE_USD=0.60
