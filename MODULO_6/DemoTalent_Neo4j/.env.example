# Copiar a .env y pegar tu API key de Google AI Studio
# (https://aistudio.google.com/apikey, es gratis).
GOOGLE_API_KEY=tu-api-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# --- Opcionales (los valores de abajo son los que se usan si no los definís) ---
# Modelo de Gemini del agente. Si tu clave nueva no tiene acceso a gemini-2.5-flash (`./run.sh check` te lo dice),
# probá gemini-3.8-flash: con ese modelo el agente también usó las herramientas esperadas en 21 de 21 corridas
# (no se probó con una clave gratuita nueva). Otros modelos: https://ai.google.dev/gemini-api/docs/models
# DEMO_MODEL=gemini-2.5-flash
# Modelo de embeddings (768 dimensiones). Si lo cambiás, borrá el grafo y repetí ./run.sh calibrar:
# los umbrales de similitud están elegidos para este modelo.
# EMBED_MODEL=gemini-embedding-001

# --- Neo4j de la demo (corre solo en tu máquina, en Docker) ---
# La clave solo se aplica al crear el contenedor por primera vez; para cambiarla después: ./run.sh reset
# TALENT_NEO4J_PASSWORD=demo-talent-local
# TALENT_HTTP_PORT=7475
# TALENT_BOLT_PORT=7688
