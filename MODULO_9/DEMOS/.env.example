# Copiar a .env y pegar tu API key de Google AI Studio
# (https://aistudio.google.com/apikey, es gratis).
GOOGLE_API_KEY=tu-api-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Opcional: modelo de Gemini del agente y de los jueces (por defecto, gemini-2.5-flash).
# Google limita los modelos 2.5 a quienes ya los usaron. Si tu key es nueva y la primera
# llamada falla con un error de modelo no encontrado o no disponible, probá uno más nuevo
# (por ejemplo gemini-3.8-flash). Otro modelo puede tardar más y juzgar distinto: las cifras de
# referencia y las estimaciones de costo son de 2.5 Flash.
# MODEL_NAME=gemini-2.5-flash
